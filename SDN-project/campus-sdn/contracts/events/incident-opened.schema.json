{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campus-sdn/contracts/events/incident-opened.schema.json",
  "title": "IncidentOpened",
  "description": "Se abre un incidente. Productor: Incidentes. Consumidores: Políticas, Consola, Auditoría.",
  "type": "object",
  "required": [
    "incident",
    "type",
    "target",
    "severity",
    "opened_at"
  ],
  "additionalProperties": false,
  "properties": {
    "incident": {
      "type": "string",
      "description": "identificador del incidente, p. ej. INC-0042"
    },
    "type": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "origins": {
      "type": "array",
      "description": "orígenes atribuidos (R4): puerto y MAC de ingreso del tráfico hacia el destino; opcional",
      "items": {
        "type": "object",
        "required": [
          "mac",
          "switch",
          "port"
        ],
        "additionalProperties": false,
        "properties": {
          "mac": {
            "type": "string"
          },
          "switch": {
            "type": "string"
          },
          "port": {
            "type": "string"
          }
        }
      }
    }
  }
}

# Configuración no secreta de los servicios en el corte nativo.
# Copiar a /etc/campus-sdn/services.env y completar con los datos del slice
# (los DPID salen de GET /onos/v1/devices). Los secretos viven en
# /etc/campus-sdn/env, que genera install_controller.sh.
ONOS_URL=http://127.0.0.1:8181
# Comillas simples: el archivo lo leen systemd y `set -a; . archivo` (bash).
SWITCH_DPIDS='{"sw1": "of:<dpid-sw1>", "sw2": "of:<dpid-sw2>", "sw3": "of:<dpid-sw3>"}'
# Esqueleto: servidores del plano de datos (confianza 60) y portal
SKELETON_SERVERS=10.0.0.3,10.0.0.4
SKELETON_PORTAL=192.168.0.10/32
I2_URL=http://127.0.0.1:8090
IAM_URL=http://127.0.0.1:8001
REGISTRY_URL=http://127.0.0.1:8002
RADIUS_HOST=127.0.0.1
STUB_VERIFY=0

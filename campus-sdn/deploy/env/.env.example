# Plantilla de variables de entorno.
# Copiar a .env (ignorado por git) y completar con valores reales al
# desplegar. Nunca versionar el .env real; para el slice se prefiere
# Ansible Vault, y estas variables son el respaldo para el uso local.
COMPOSE_DIR=/opt/campus-sdn/deploy/compose
TZ=America/Lima

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_USER=plataforma
RABBITMQ_PASSWORD=
LDAP_ADMIN_PASSWORD=
LDAP_READONLY_PASSWORD=
RADIUS_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Servicios propios de S1
# STUB_VERIFY=1 acepta cualquier credencial: solo para pruebas, jamás en
# el slice. BUS_URL apunta al bus (SRV-1): amqp://usuario:clave@10.0.0.11:5672.
# IAM_URL lo usa la Consola para el SSO del operador. RADIUS_HOST es el
# IdP primario (SRV-1). I2_URL apunta al adaptador del controlador.
STUB_VERIFY=
BUS_URL=
IAM_URL=
RADIUS_HOST=10.0.0.11
I2_URL=

# S2 — Observabilidad
# Interfaz del espejo hacia el sensor: ens6 cuando la nube la entregue.
MIRROR_IFACE=ens6

# Publicación de puertos por VM (plataforma activo-activo)
# SERVICE_BIND_IP: IP de datos en la que escuchan los servicios propios
# (10.0.0.12 en SRV-2, 10.0.0.13 en SRV-3; por defecto, todas).
# RADIUS_BIND_IP: IP de datos del IdP primario (10.0.0.11 en SRV-1).
# RABBITMQ_BIND_IP: IP de datos del bus (10.0.0.11 en SRV-1).
# REDIS_PASSWORD: clave de Redis (SRV-1), si se habilita.
SERVICE_BIND_IP=
RADIUS_BIND_IP=
RABBITMQ_BIND_IP=
REDIS_PASSWORD=

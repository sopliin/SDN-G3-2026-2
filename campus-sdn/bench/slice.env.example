# Acceso al slice para bench/ (campañas, demo y verificaciones remotas).
#
# Copiar a bench/slice.env (ignorado por git: el patrón *.env) y completar.
# bench/slice.py lo carga solo; una variable ya definida en el entorno
# tiene prioridad sobre el archivo. Formato: CLAVE=valor, sin espacios
# alrededor del «=»; las comillas externas son opcionales. Nunca versionar
# el archivo con valores.

# --- Acceso SSH -----------------------------------------------------------
# Gateway del slice (las VMs se alcanzan por sus puertos DNAT).
SLICE_GATEWAY=10.20.12.185
SLICE_USER=ubuntu
# Contraseña de SSH de las VMs. Vacía = solo clave pública. Con valor, se
# intenta primero la clave y luego la contraseña (SSH_ASKPASS: no aparece
# en la línea de comandos).
SLICE_SSH_PASSWORD=
# Contraseña de sudo en las VMs (se pasa por stdin a `sudo -S`).
SLICE_SUDO_PASSWORD=

# --- ONOS ----------------------------------------------------------------
ONOS_USER=karaf
ONOS_PASSWORD=

# --- Cuentas para las pruebas ----------------------------------------------
# Operador existente (network_admin o super_admin) con su secreto TOTP en
# base32 (el `secret=` de la URI otpauth:// entregada al darlo de alta).
SLICE_ADMIN_USER=
SLICE_ADMIN_PASSWORD=
SLICE_ADMIN_TOTP_SECRET=
# Cuenta académica principal (vacía = semilla USR-0001 / user_0001).
SLICE_ACADEMIC_USER=
SLICE_ACADEMIC_PASSWORD=

# --- Parámetros desplegados que las campañas deben conocer -----------------
# Deben coincidir con RATE_LIMIT_PPS y MITIGATION_TTL_S de Políticas.
BENCH_RATE_LIMIT_PPS=1000
BENCH_MITIGATION_TTL_S=300
# Alcances por perfil si el IAM los redefine (JSON); vacío = SESSION_SCOPE.
PROFILE_SCOPES=

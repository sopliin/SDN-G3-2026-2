# Los archivos generados llevan secretos del .env (plantillas en el repo)
campus-sdn/deploy/radius/mods-ldap
campus-sdn/deploy/radius/clients.conf

# Entregables del curso: se mantienen locales, no se publican en GitHub.
campus-sdn/docs/informe-previo/

# Python y herramientas
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
*.retry

# Sistema
.DS_Store
._*

# Artefactos de pruebas y de pip install -e

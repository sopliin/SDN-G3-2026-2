.claude/
*.pptx
*.png

# PDF externos (sílabo, enunciado, exportaciones)
/*.[pP][dD][fF]

# Secretos y configuración real del slice: nunca versionados.
.env
*.env
!*.env.example
campus-sdn/deploy/env/.env
campus-sdn/deploy/env/.env.*
!campus-sdn/deploy/env/.env.example
**/inventory/slice.yml
**/vault/
*.pem
*.key

# Imágenes empaquetadas: git guarda el lock, no los binarios.
